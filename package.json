{
  "name": "energiease-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/seeds/index.ts",
    "build": "tsc && tsc-alias",
    "generate:keys": "node dist/utils/accessKeyGenerator.js",
    "generate:keys-dev": "tsx src/utils/accessKeyGenerator.ts",
    "start": "node -r tsconfig-paths/register dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "precommit": "eslint .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@azure/service-bus": "^7.9.5",
    "@esbuild/darwin-arm64": "0.25.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "axios": "^1.8.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "envalid": "^8.0.0",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "pdfkit": "^0.20.2",
    "pino-pretty": "^13.0.0",
    "redis": "^4.7.0",
    "svg-to-pdfkit": "^0.1.8",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pdfkit": "^0.17.6",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
